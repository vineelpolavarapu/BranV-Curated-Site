# Copy to deploy/.env on the VM and fill in real secrets.
# DO NOT commit deploy/.env to git.

# ── Caddy / TLS ────────────────────────────────────────────────────────────
API_HOSTNAME=api.example.com
ACME_EMAIL=admin@example.com

# ── Postgres (used by the API and the backup container) ───────────────────
# Generate: openssl rand -hex 32
DB_PASSWORD=

# ── API auth secrets ──────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Cookie / CORS ─────────────────────────────────────────────────────────
# COOKIE_DOMAIN should match the parent of both the web and api hosts so the
# auth cookies are sent on API calls from the Vercel-hosted web app.
# Example: ".example.com"  (leading dot for subdomain coverage)
COOKIE_DOMAIN=.example.com
WEB_ORIGIN=https://www.example.com

# ── Object storage (Cloudflare R2 recommended; 10 GB free) ────────────────
# R2 endpoint format: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=branv-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Affiliate integrations ────────────────────────────────────────────────
CUELINKS_API_KEY=
AMAZON_ASSOCIATES_TAG=branv-21
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
EARNKARO_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────
MAIL_API_KEY=
MAIL_FROM=hello@example.com

# ── Backups → Cloudflare R2 ───────────────────────────────────────────────
# Create a second R2 bucket for the nightly pg_dump.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BACKUP_BUCKET=branv-pg-backups
