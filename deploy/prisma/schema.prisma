// BranV - Prisma schema
// Phase 1: Identity. Phase 2: Brands, Categories, Products, Variants, Images,
// Retailer Listings, Attribute Schemas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── PHASE 1 - IDENTITY ────────────────────────────

enum UserRole {
  MEMBER
  ADMIN
  // STAFF reserved for v2 (per PRD §4.4)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  role              UserRole   @default(MEMBER)
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  totpSecret        String?
  totpEnabled       Boolean    @default(false)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  profile             MemberProfile?
  refreshTokens       RefreshToken[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  auditLogs           AuditLog[]          @relation("ActorAuditLogs")
  createdProducts     Product[]           @relation("ProductCreatedBy")
  authoredArticles    Article[]           @relation("ArticleAuthor")
  clickEvents             ClickEvent[]             @relation("UserClicks")
  selfReportedConversions SelfReportedConversion[] @relation("UserConversions")
  wardrobeItems           WardrobeItem[]           @relation("UserWardrobe")
  wishlistItems           WishlistItem[]           @relation("UserWishlist")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  settingsUpdates         PlatformSetting[]        @relation("SettingsUpdatedBy")

  @@map("users")
}

model MemberProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  phone     String?
  dob       DateTime?
  avatarUrl String?
  tier      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("member_profiles")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ──────────────────────────── PHASE 2 - CATALOG ────────────────────────────

enum BrandStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AvailabilityStatus {
  IN_STOCK
  OUT_OF_STOCK_AT_RETAILER
  DELISTED
}

enum FilterType {
  SELECT
  MULTI_SELECT
  RANGE
  TOGGLE
}

model Brand {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  logoUrl     String?
  heroUrl     String?
  description String?
  isFeatured  Boolean     @default(false)
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products Product[]
  story    BrandStory?

  @@index([status, isFeatured])
  @@map("brands")
}

model Category {
  id           String     @id @default(cuid())
  parentId     String?
  parent       Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("Subcategories")
  slug         String     @unique
  name         String
  /// Denormalized path, e.g. "clothing/shirts" - fast lookup, easy breadcrumbs.
  path         String     @unique
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  productsAsCategory    Product[]                 @relation("ProductCategory")
  productsAsSubcategory Product[]                 @relation("ProductSubcategory")
  attributeSchemas      CategoryAttributeSchema[]
  categoryLinks         ProductCategoryLink[]

  @@index([parentId])
  @@map("categories")
}

model CategoryAttributeSchema {
  id           String     @id @default(cuid())
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeKey String
  displayName  String
  filterType   FilterType @default(SELECT)
  optionsJson  Json?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([categoryId, attributeKey])
  @@map("category_attribute_schemas")
}

model Product {
  id                 String        @id @default(cuid())
  brandId            String
  brand              Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId         String
  category           Category      @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId      String?
  subcategory        Category?     @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  slug               String        @unique
  title              String
  description        String?
  primaryRetailer    String?
  status             ProductStatus @default(DRAFT)
  createdByAdminId   String?
  createdByAdmin     User?         @relation("ProductCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  metaTitle          String?
  metaDescription    String?
  tags               String[]      @default([])
  archivedAt         DateTime?
  /// When set and > now(), the product is "featured" - sorted to the front
  /// of its category section on the home page and shown with a Featured
  /// badge. Cleared (or simply ignored) once the timestamp has passed.
  featuredUntil      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  variants         ProductVariant[]
  images           ProductImage[]
  retailerListings ProductRetailerListing[]
  clickEvents      ClickEvent[]
  wardrobeItems    WardrobeItem[]
  wishlistItems    WishlistItem[]
  editProducts     EditProduct[]
  categoryLinks    ProductCategoryLink[]

  @@index([status])
  @@index([brandId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status, categoryId, createdAt])
  @@index([status, brandId, createdAt])
  @@index([createdAt])
  @@index([featuredUntil])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  attributes Json     @default("{}")
  color      String?
  size       String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url           String
  altText       String?
  isPrimary     Boolean  @default(false)
  isAiGenerated Boolean  @default(false)
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductRetailerListing {
  id                 String             @id @default(cuid())
  productId          String
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer           String
  /// Admin-entered display label shown as "Buy on {retailerDisplayName}"
  /// when `retailer` is 'other' (or otherwise unmapped) - overrides the
  /// hardcoded retailerLabel lookup on the frontend.
  retailerDisplayName String?
  retailerProductUrl String
  retailerImageUrl   String?
  rawPrice           Decimal?           @db.Decimal(12, 2)
  lastSyncedAt       DateTime?
  /// Increments on each failed sync; reset to 0 on success. After 3
  /// consecutive failures the listing is flagged for admin review.
  syncFailedCount    Int                @default(0)
  availabilityStatus AvailabilityStatus @default(IN_STOCK)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  affiliateLinks AffiliateLink[]

  @@unique([productId, retailer])
  @@index([retailer])
  @@index([productId, availabilityStatus])
  @@map("product_retailer_listings")
}

enum AffiliatePartner {
  CUELINKS
  AMAZON
  EARNKARO
  MEESHO
  DIRECT
}

model AffiliateLink {
  id                       String                  @id @default(cuid())
  productRetailerListingId String
  productRetailerListing   ProductRetailerListing  @relation(fields: [productRetailerListingId], references: [id], onDelete: Cascade)
  partner                  AffiliatePartner
  rawUrl                   String
  convertedUrl             String
  partnerLinkId            String?
  pendingConversion        Boolean                 @default(false)
  lastValidatedAt          DateTime?
  lastError                String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([productRetailerListingId])
  @@index([pendingConversion])
  @@map("affiliate_links")
}

// ──────────────────────── PHASE 5 - CLICK-OUT FLOW ────────────────────────

enum ClickReportOutcome {
  PURCHASED
  BROWSING
  NEEDS_HELP
}

/// Short-lived intent created when the storefront mints a tracking link;
/// consumed by /go on redirect. Replaces the previous Redis-backed store so
/// the API has no Redis dependency. Rows past `expiresAt` are ignored on
/// read and swept by a periodic cleanup job.
model ClickIntent {
  trackingId    String            @id
  productId     String
  retailer      String
  partner       AffiliatePartner?
  partnerUrl    String
  sourcePageUrl String?
  expiresAt     DateTime
  createdAt     DateTime          @default(now())

  @@index([expiresAt])
  @@map("click_intents")
}

model ClickEvent {
  id            String            @id @default(cuid())
  trackingId    String            @unique
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer      String
  partner       AffiliatePartner?
  partnerUrl    String
  sourcePageUrl String?
  userId        String?
  user          User?             @relation("UserClicks", fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String?
  userAgent     String?
  ipCountry     String?
  utm           Json?
  redirectedAt  DateTime          @default(now())

  reports        SelfReportedConversion[]
  wardrobeItems  WardrobeItem[]

  @@index([productId])
  @@index([userId])
  @@index([redirectedAt])
  @@map("click_events")
}

model SelfReportedConversion {
  id           String             @id @default(cuid())
  clickEventId String
  clickEvent   ClickEvent         @relation(fields: [clickEventId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?              @relation("UserConversions", fields: [userId], references: [id], onDelete: SetNull)
  outcome      ClickReportOutcome
  reportedAt   DateTime           @default(now())

  @@index([clickEventId])
  @@index([userId])
  @@index([outcome])
  @@map("self_reported_conversions")
}

model WardrobeItem {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation("UserWardrobe", fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  retailer           String
  clickEventId       String?
  clickEvent         ClickEvent? @relation(fields: [clickEventId], references: [id], onDelete: SetNull)
  selfReportedPrice  Decimal?    @db.Decimal(12, 2)
  selfReportedDate   DateTime?
  notes              String?
  tags               String[]    @default([])
  removedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wardrobe_items")
}

model WishlistItem {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("UserWishlist", fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifyOnPriceDrop Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

// Product ⇄ Category many-to-many visibility links.
//
// Backs the admin product form's "Product Visibility - select categories this
// product appears in" checkboxes. A product's primary placement is still its
// single `categoryId`/`subcategoryId`; rows here add *extra* category/collection
// landing pages the product should also surface on. The storefront category
// listing unions these links with the primary category/subcategory match.
model ProductCategoryLink {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_category_links")
}

// ──────────────────────── PHASE 6 - ARTICLES ────────────────────────

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Article {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  heroUrl         String?
  excerpt         String?
  /// Markdown body. Product embeds use `<div data-product="slug"></div>`
  /// markers that the renderer replaces with shoppable product cards.
  bodyMd          String        @default("")
  status          ArticleStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  authorId        String?
  author          User?         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tags            String[]      @default([])
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  /// Estimated reading time in minutes (auto-calculated on save at ~225 wpm).
  readingMinutes  Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([scheduledAt])
  @@map("articles")
}

// ───────── PHASE 7 - EDITS / BRAND STORIES ─────────

enum EditStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Edit {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  heroUrl          String?
  description      String?
  status           EditStatus @default(DRAFT)
  /// At most one edit at a time should be the home feature; admin-enforced.
  isFeaturedOnHome Boolean    @default(false)
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  editProducts EditProduct[]

  @@index([status])
  @@index([isFeaturedOnHome])
  @@map("edits")
}

model EditProduct {
  id        String  @id @default(cuid())
  editId    String
  edit      Edit    @relation(fields: [editId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([editId, productId])
  @@index([editId])
  @@map("edit_products")
}

enum BrandStoryStatus {
  DRAFT
  PUBLISHED
}

model BrandStory {
  id        String           @id @default(cuid())
  brandId   String           @unique
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  heroUrl   String?
  /// Markdown body. Rendered with rehype-sanitize on the storefront so raw
  /// HTML is stripped - XSS-safe even when admin pastes untrusted content.
  bodyMd    String           @default("")
  status    BrandStoryStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("brand_stories")
}

// ───────── PHASE 8 - NOTIFICATIONS ─────────

enum NotificationChannel {
  EMAIL
  IN_APP
  WEB_PUSH
  SMS
}

enum NotificationType {
  WELCOME
  WISHLIST_PRICE_DROP
  DROP_LAUNCHING_SOON
  DROP_LIVE
  NEW_ARTICLE
  REVIEW_HIDDEN
  ADMIN_SYNC_FAILURE
  ADMIN_WEEKLY_SUMMARY
  GENERIC
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  /// Free-form: { title, body, link, productId, dropSlug, etc. }
  payload   Json
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

/// Outbox pattern (BUILD_GUIDE §8.3): rows are written inside the same DB
/// transaction as whatever business event produced them. The admin
/// dashboard reads PENDING/FAILED counts for observability.
model NotificationOutbox {
  id            String              @id @default(cuid())
  email         String?
  channel       NotificationChannel
  payload       Json
  status        OutboxStatus        @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status])
  @@map("notification_outbox")
}

// ───────── PHASE 10 - PLATFORM SETTINGS ─────────

/// Key-value store for runtime-tunable settings (sync thresholds, feature
/// flags, default currency). Reads are cached in-process for ~30s by
/// SettingsService so the next request cycle picks up writes.
model PlatformSetting {
  key           String   @id
  valueJson     Json
  updatedById   String?
  updatedBy     User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("platform_settings")
}