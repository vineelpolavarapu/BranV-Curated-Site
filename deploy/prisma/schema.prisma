// BranV — Prisma schema
// Phase 1: Identity. Phase 2: Brands, Categories, Products, Variants, Images,
// Retailer Listings, Attribute Schemas, Avatars.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── PHASE 1 — IDENTITY ────────────────────────────

enum UserRole {
  MEMBER
  ADMIN
  // STAFF reserved for v2 (per PRD §4.4)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  role              UserRole   @default(MEMBER)
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  totpSecret        String?
  totpEnabled       Boolean    @default(false)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  profile             MemberProfile?
  refreshTokens       RefreshToken[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  auditLogs           AuditLog[]          @relation("ActorAuditLogs")
  createdProducts     Product[]           @relation("ProductCreatedBy")
  authoredArticles    Article[]           @relation("ArticleAuthor")
  clickEvents             ClickEvent[]             @relation("UserClicks")
  selfReportedConversions SelfReportedConversion[] @relation("UserConversions")
  wardrobeItems           WardrobeItem[]           @relation("UserWardrobe")
  wishlistItems           WishlistItem[]           @relation("UserWishlist")
  reviews                 Review[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  newsletterSubscriber    NewsletterSubscriber?
  uploadedPayouts         AffiliatePayout[]        @relation("PayoutUploadedBy")
  settingsUpdates         PlatformSetting[]        @relation("SettingsUpdatedBy")

  @@index([email])
  @@map("users")
}

model MemberProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  phone     String?
  dob       DateTime?
  avatarUrl String?
  tier      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("member_profiles")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ──────────────────────────── PHASE 2 — CATALOG ────────────────────────────

enum BrandStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AvailabilityStatus {
  IN_STOCK
  OUT_OF_STOCK_AT_RETAILER
  DELISTED
}

enum FilterType {
  SELECT
  MULTI_SELECT
  RANGE
  TOGGLE
}

model Brand {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  logoUrl     String?
  heroUrl     String?
  description String?
  isFeatured  Boolean     @default(false)
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products Product[]
  story    BrandStory?

  @@index([status, isFeatured])
  @@map("brands")
}

model Category {
  id           String     @id @default(cuid())
  parentId     String?
  parent       Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("Subcategories")
  slug         String     @unique
  name         String
  /// Denormalized path, e.g. "clothing/shirts" — fast lookup, easy breadcrumbs.
  path         String     @unique
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  productsAsCategory    Product[]                 @relation("ProductCategory")
  productsAsSubcategory Product[]                 @relation("ProductSubcategory")
  attributeSchemas      CategoryAttributeSchema[]

  @@index([parentId])
  @@map("categories")
}

model CategoryAttributeSchema {
  id           String     @id @default(cuid())
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeKey String
  displayName  String
  filterType   FilterType @default(SELECT)
  optionsJson  Json?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([categoryId, attributeKey])
  @@map("category_attribute_schemas")
}

model Product {
  id                 String        @id @default(cuid())
  brandId            String
  brand              Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId         String
  category           Category      @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId      String?
  subcategory        Category?     @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  slug               String        @unique
  title              String
  description        String?
  price              Decimal       @db.Decimal(12, 2)
  mrp                Decimal?      @db.Decimal(12, 2)
  discountPct        Decimal?      @db.Decimal(5, 2)
  currency           String        @default("INR")
  primaryRetailer    String?
  status             ProductStatus @default(DRAFT)
  createdByAdminId   String?
  createdByAdmin     User?         @relation("ProductCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  metaTitle          String?
  metaDescription    String?
  tags               String[]      @default([])
  archivedAt         DateTime?
  /// Denormalized review aggregates — maintained by ReviewsService on
  /// create / moderate so storefront sort + filter stay cheap.
  avgRating          Decimal?      @db.Decimal(3, 2)
  reviewCount        Int           @default(0)
  /// When set and > now(), the product is "featured" — sorted to the front
  /// of its category section on the home page and shown with a Featured
  /// badge. Cleared (or simply ignored) once the timestamp has passed.
  featuredUntil      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  variants         ProductVariant[]
  images           ProductImage[]
  retailerListings ProductRetailerListing[]
  clickEvents      ClickEvent[]
  wardrobeItems    WardrobeItem[]
  wishlistItems    WishlistItem[]
  articleEmbeds    ArticleProduct[]
  editProducts     EditProduct[]
  lookbookTags     LookbookTag[]
  reviews          Review[]

  @@index([status])
  @@index([brandId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([featuredUntil])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  attributes Json     @default("{}")
  color      String?
  size       String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url           String
  altText       String?
  isPrimary     Boolean  @default(false)
  isAiGenerated Boolean  @default(false)
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductRetailerListing {
  id                 String             @id @default(cuid())
  productId          String
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer           String
  retailerDisplayName String?
  retailerProductUrl String
  retailerImageUrl   String?
  rawPrice           Decimal?           @db.Decimal(12, 2)
  lastSyncedAt       DateTime?
  /// Increments on each failed sync; reset to 0 on success. After 3
  /// consecutive failures the listing is flagged for admin review.
  syncFailedCount    Int                @default(0)
  syncFailedSince    DateTime?
  availabilityStatus AvailabilityStatus @default(IN_STOCK)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  affiliateLinks AffiliateLink[]

  @@unique([productId, retailer])
  @@index([retailer])
  @@map("product_retailer_listings")
}

enum AffiliatePartner {
  CUELINKS
  AMAZON
  EARNKARO
  MEESHO
  DIRECT
}

model AffiliateLink {
  id                       String                  @id @default(cuid())
  productRetailerListingId String
  productRetailerListing   ProductRetailerListing  @relation(fields: [productRetailerListingId], references: [id], onDelete: Cascade)
  partner                  AffiliatePartner
  rawUrl                   String
  convertedUrl             String
  partnerLinkId            String?
  pendingConversion        Boolean                 @default(false)
  lastValidatedAt          DateTime?
  lastError                String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([productRetailerListingId])
  @@index([pendingConversion])
  @@map("affiliate_links")
}

// ──────────────────────── PHASE 5 — CLICK-OUT FLOW ────────────────────────

enum ClickReportOutcome {
  PURCHASED
  BROWSING
  NEEDS_HELP
}

/// Short-lived intent created when the storefront mints a tracking link;
/// consumed by /go on redirect. Replaces the previous Redis-backed store so
/// the API has no Redis dependency. Rows past `expiresAt` are ignored on
/// read and swept by a periodic cleanup job.
model ClickIntent {
  trackingId    String            @id
  productId     String
  retailer      String
  partner       AffiliatePartner?
  partnerUrl    String
  sourcePageUrl String?
  expiresAt     DateTime
  createdAt     DateTime          @default(now())

  @@index([expiresAt])
  @@map("click_intents")
}

model ClickEvent {
  id            String            @id @default(cuid())
  trackingId    String            @unique
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer      String
  partner       AffiliatePartner?
  partnerUrl    String
  sourcePageUrl String?
  userId        String?
  user          User?             @relation("UserClicks", fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String?
  userAgent     String?
  ipCountry     String?
  utm           Json?
  redirectedAt  DateTime          @default(now())

  reports        SelfReportedConversion[]
  wardrobeItems  WardrobeItem[]
  payoutItems    AffiliatePayoutItem[]

  @@index([productId])
  @@index([userId])
  @@index([redirectedAt])
  @@map("click_events")
}

model SelfReportedConversion {
  id           String             @id @default(cuid())
  clickEventId String
  clickEvent   ClickEvent         @relation(fields: [clickEventId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?              @relation("UserConversions", fields: [userId], references: [id], onDelete: SetNull)
  outcome      ClickReportOutcome
  reportedAt   DateTime           @default(now())

  @@index([clickEventId])
  @@index([userId])
  @@index([outcome])
  @@map("self_reported_conversions")
}

model WardrobeItem {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation("UserWardrobe", fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  retailer           String
  clickEventId       String?
  clickEvent         ClickEvent? @relation(fields: [clickEventId], references: [id], onDelete: SetNull)
  selfReportedPrice  Decimal?    @db.Decimal(12, 2)
  selfReportedDate   DateTime?
  notes              String?
  tags               String[]    @default([])
  removedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wardrobe_items")
}

model WishlistItem {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("UserWishlist", fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifyOnPriceDrop Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

model Avatar {
  id                String   @id @default(cuid())
  name              String
  referenceImageUrl String
  promptTemplate    String
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("avatars")
}

// ──────────────────────── PHASE 6 — ARTICLES ────────────────────────

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Article {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  heroUrl         String?
  excerpt         String?
  /// Markdown body. Product embeds use `<div data-product="slug"></div>`
  /// markers that the renderer replaces with shoppable product cards.
  bodyMd          String        @default("")
  status          ArticleStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  authorId        String?
  author          User?         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tags            String[]      @default([])
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  /// Estimated reading time in minutes (auto-calculated on save at ~225 wpm).
  readingMinutes  Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  articleProducts ArticleProduct[]

  @@index([status, publishedAt])
  @@index([scheduledAt])
  @@map("articles")
}

model ArticleProduct {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([articleId, productId])
  @@index([articleId])
  @@map("article_products")
}

// ───────── PHASE 7 — LOOKBOOKS / EDITS / BANNERS / BRAND STORIES ─────────

enum LookbookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Lookbook {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  heroUrl     String?
  description String?
  status      LookbookStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  images LookbookImage[]

  @@index([status])
  @@map("lookbooks")
}

model LookbookImage {
  id         String   @id @default(cuid())
  lookbookId String
  lookbook   Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)
  imageUrl   String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  tags LookbookTag[]

  @@index([lookbookId])
  @@map("lookbook_images")
}

model LookbookTag {
  id              String        @id @default(cuid())
  lookbookImageId String
  lookbookImage   LookbookImage @relation(fields: [lookbookImageId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Hotspot position relative to the image, both 0–100.
  xPercent        Decimal       @db.Decimal(5, 2)
  yPercent        Decimal       @db.Decimal(5, 2)
  createdAt       DateTime      @default(now())

  @@index([lookbookImageId])
  @@map("lookbook_tags")
}

enum EditStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Edit {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  heroUrl          String?
  description      String?
  status           EditStatus @default(DRAFT)
  /// At most one edit at a time should be the home feature; admin-enforced.
  isFeaturedOnHome Boolean    @default(false)
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  editProducts EditProduct[]

  @@index([status])
  @@index([isFeaturedOnHome])
  @@map("edits")
}

model EditProduct {
  id        String  @id @default(cuid())
  editId    String
  edit      Edit    @relation(fields: [editId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([editId, productId])
  @@index([editId])
  @@map("edit_products")
}

enum HomeBannerStatus {
  ACTIVE
  HIDDEN
}

model HomeBanner {
  id           String           @id @default(cuid())
  imageUrl     String
  headline     String?
  ctaLabel     String?
  ctaLink      String?
  displayOrder Int              @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  status       HomeBannerStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, displayOrder])
  @@map("home_banners")
}

enum BrandStoryStatus {
  DRAFT
  PUBLISHED
}

model BrandStory {
  id        String           @id @default(cuid())
  brandId   String           @unique
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  heroUrl   String?
  /// Markdown body. Rendered with rehype-sanitize on the storefront so raw
  /// HTML is stripped — XSS-safe even when admin pastes untrusted content.
  bodyMd    String           @default("")
  status    BrandStoryStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("brand_stories")
}

// ───────── PHASE 8 — REVIEWS / NEWSLETTER / NOTIFICATIONS ─────────

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  title            String?
  body             String?
  /// Optional gallery — array of S3 URLs uploaded via /uploads/presign.
  imagesJson       Json?
  status           ReviewStatus @default(PUBLISHED)
  moderationReason String?
  moderatedById    String?
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([userId])
  @@map("reviews")
}

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id                    String           @id @default(cuid())
  email                 String           @unique
  userId                String?          @unique
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  source                String?
  status                NewsletterStatus @default(PENDING)
  /// sha256 of a single-use confirmation token. Cleared after CONFIRMED.
  confirmationTokenHash String?          @unique
  /// sha256 of a long-lived unsubscribe token. Stable across re-subscribes.
  unsubscribeTokenHash  String           @unique
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status])
  @@map("newsletter_subscribers")
}

enum NotificationChannel {
  EMAIL
  IN_APP
  WEB_PUSH
  SMS
}

enum NotificationType {
  WELCOME
  WISHLIST_PRICE_DROP
  DROP_LAUNCHING_SOON
  DROP_LIVE
  NEW_ARTICLE
  REVIEW_HIDDEN
  ADMIN_SYNC_FAILURE
  ADMIN_WEEKLY_SUMMARY
  GENERIC
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  /// Free-form: { title, body, link, productId, dropSlug, etc. }
  payload   Json
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

/// Outbox pattern (BUILD_GUIDE §8.3): rows are written inside the same DB
/// transaction as whatever business event produced them. A scheduled
/// dispatcher reads PENDING and fires the channel-specific side effect
/// (mail send, in-app insert, …). Survives backend restarts because the
/// queue lives in the DB.
model NotificationOutbox {
  id            String              @id @default(cuid())
  userId        String?
  /// Some notifications target an anonymous newsletter subscriber by email.
  email         String?
  type          NotificationType
  channel       NotificationChannel
  payload       Json
  status        OutboxStatus        @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?
  scheduledFor  DateTime            @default(now())
  dispatchedAt  DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, scheduledFor])
  @@map("notification_outbox")
}

// ───────── PHASE 9 — AFFILIATE PAYOUTS / RECONCILIATION ─────────

enum AffiliatePayoutItemStatus {
  /// Matched to exactly one click_events row.
  MATCHED
  /// No click_events candidate within the window/amount band.
  UNMATCHED
  /// Multiple candidates within window — admin reviews manually.
  AMBIGUOUS
}

/// One row per uploaded CSV file. `csvHash` is sha256 of the file bytes so
/// re-uploading the same export is a no-op (BUILD_GUIDE §9.1 step 3 — idempotent).
model AffiliatePayout {
  id                    String           @id @default(cuid())
  partner               AffiliatePartner
  reportedPeriodStart   DateTime?
  reportedPeriodEnd     DateTime?
  reportedClicks        Int?
  reportedOrders        Int?
  reportedCommissionInr Decimal?         @db.Decimal(14, 2)
  csvHash               String           @unique
  csvFilename           String?
  rowCount              Int              @default(0)
  matchedCount          Int              @default(0)
  unmatchedCount        Int              @default(0)
  ambiguousCount        Int              @default(0)
  uploadedById          String?
  uploadedBy            User?            @relation("PayoutUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  notes                 String?
  createdAt             DateTime         @default(now())

  items AffiliatePayoutItem[]

  @@index([partner, createdAt])
  @@map("affiliate_payouts")
}

model AffiliatePayoutItem {
  id                  String                    @id @default(cuid())
  payoutId            String
  payout              AffiliatePayout           @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  matchedClickEventId String?
  matchedClickEvent   ClickEvent?               @relation(fields: [matchedClickEventId], references: [id], onDelete: SetNull)
  retailerOrderId     String?
  amountInr           Decimal?                  @db.Decimal(14, 2)
  commissionInr       Decimal?                  @db.Decimal(14, 2)
  occurredAt          DateTime?
  status              AffiliatePayoutItemStatus @default(UNMATCHED)
  /// Sha256 of the normalized row contents — dedupe within a single payout.
  rowHash             String
  /// Verbatim CSV row, for admin debugging.
  rawRow              Json?
  createdAt           DateTime                  @default(now())

  @@unique([payoutId, rowHash])
  @@index([matchedClickEventId])
  @@index([status])
  @@map("affiliate_payout_items")
}

// ───────── PHASE 10 — PLATFORM SETTINGS ─────────

/// Key-value store for runtime-tunable settings (sync thresholds, feature
/// flags, default currency). Reads are cached in-process for ~30s by
/// SettingsService so the next request cycle picks up writes.
model PlatformSetting {
  key           String   @id
  valueJson     Json
  updatedById   String?
  updatedBy     User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("platform_settings")
}

// ───────── PHASE 10 — ANALYTICS ROLLUPS ─────────
//
// Hourly worker (AnalyticsRollupService) aggregates raw click_events,
// self_reported_conversions, and affiliate_payout_items into these summary
// tables so dashboard queries stay sub-second as raw volume grows. Upserts
// keep them idempotent; we rebuild the trailing N days each tick so
// late-arriving reconciliation rows don't get lost.

/// One row per (day × product × retailer). Sourced from click_events.
model AnalyticsDailyClicks {
  day         DateTime @db.Date
  productId   String
  retailer    String
  clicks      Int      @default(0)
  uniqueUsers Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([day, productId, retailer])
  @@index([day])
  @@index([productId])
  @@map("analytics_daily_clicks")
}

/// One row per (day × product). Sourced from self_reported_conversions and
/// affiliate_payout_items (reconciled).
model AnalyticsDailyConversions {
  day                     DateTime @db.Date
  productId               String
  selfReportedPurchases   Int      @default(0)
  selfReportedBrowsing    Int      @default(0)
  selfReportedNeedsHelp   Int      @default(0)
  estimatedCommissionInr  Decimal  @default(0) @db.Decimal(14, 2)
  reconciledCommissionInr Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt               DateTime @updatedAt

  @@id([day, productId])
  @@index([day])
  @@map("analytics_daily_conversions")
}

/// One row per (day × surface). `surfaceType` is 'article'|'drop'|'edit'|
/// 'lookbook'|'home'|'category'|'product'; `surfaceSlug` is the slug or path
/// segment derived from click_events.sourcePageUrl.
model AnalyticsContentPerf {
  day                     DateTime @db.Date
  surfaceType             String
  surfaceSlug             String
  clicks                  Int      @default(0)
  selfReportedConversions Int      @default(0)
  reconciledCommissionInr Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt               DateTime @updatedAt

  @@id([day, surfaceType, surfaceSlug])
  @@index([day])
  @@index([surfaceType, day])
  @@map("analytics_content_perf")
}
