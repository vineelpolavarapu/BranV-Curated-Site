# ─── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
BASE_CURRENCY=INR

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://branv:branv@localhost:5432/branv_dev?schema=public"

# ─── Auth (generate strong secrets in real envs: openssl rand -hex 64) ─────
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE="false"
COOKIE_DOMAIN=""
COOKIE_SAMESITE="lax"
TOTP_ISSUER="BranV"
WEB_ORIGIN="http://localhost:3000"
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MIN=15
AUTH_LOCKOUT_DURATION_MIN=15
AUTH_RATE_LIMIT_PER_MIN=5

# CLI seed (used by `pnpm seed:admin` if positional args omitted)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Object storage (MinIO local; R2 prod) ─────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="branv-dev"
S3_ACCESS_KEY="branv"
S3_SECRET_KEY="branv-secret"
S3_FORCE_PATH_STYLE="true"

# ─── External integrations (mocked unless USE_MOCK_INTEGRATIONS=false) ─────
USE_MOCK_INTEGRATIONS="true"

# Amazon Associates (direct - every other retailer's affiliate link is
# pasted in manually via EarnKaro/Meesho/etc. and stored as-is, no API call)
AMAZON_ASSOCIATES_TAG="branv-21"
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_REGION="IN"

# EarnKaro (fallback)
EARNKARO_API_KEY=""

# Email / ESP
MAIL_PROVIDER="resend"
MAIL_API_KEY=""
MAIL_FROM="hello@branv.local"

# ─── Sync worker tuning ────────────────────────────────────────────────────
PRICE_SYNC_DRIFT_THRESHOLD_PCT=5
SCRAPER_USER_AGENT="Mozilla/5.0 (compatible; BranVBot/1.0; +https://branv.local/bot)"

# ─── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api"
NEXT_PUBLIC_SITE_NAME="BranV"

# ─── Feature flags ─────────────────────────────────────────────────────────
GOOGLE_OAUTH_ENABLED="false"
WEB_PUSH_ENABLED="false"
SMS_ENABLED="false"
