{
  "name": "branv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "dotenv -e .env -- pnpm --filter \"./apps/web\" dev",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --host 127.0.0.1 --port 5000 --reload",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/web\" build",
    "lint": "pnpm --filter \"./apps/web\" lint",
    "typecheck": "pnpm --filter \"./apps/web\" typecheck",
    "db:migrate": "dotenv -e .env -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "dotenv -e .env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:generate": "dotenv -e .env -- prisma generate --schema prisma/schema.prisma",
    "db:studio": "dotenv -e .env -- prisma studio --schema prisma/schema.prisma",
    "py:install": "cd apps/api && uv sync",
    "py:test": "cd apps/api && uv run pytest tests/unit -v",
    "py:schema-check": "cd apps/api && uv run python scripts/check_schema_parity.py",
    "py:regen-models": "cd apps/api && uv run python scripts/generate_sa_models.py",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.5.4"
  }
}
