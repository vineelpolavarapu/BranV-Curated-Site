// BranV — Prisma schema
// Phase 1: Identity. Phase 2: Brands, Categories, Products, Variants, Images,
// Retailer Listings, Attribute Schemas, Avatars.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── PHASE 1 — IDENTITY ────────────────────────────

enum UserRole {
  MEMBER
  ADMIN
  // STAFF reserved for v2 (per PRD §4.4)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  role              UserRole   @default(MEMBER)
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  totpSecret        String?
  totpEnabled       Boolean    @default(false)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  profile             MemberProfile?
  refreshTokens       RefreshToken[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  auditLogs           AuditLog[]          @relation("ActorAuditLogs")
  createdProducts     Product[]           @relation("ProductCreatedBy")
  authoredArticles    Article[]           @relation("ArticleAuthor")
  dropNotifySignups   DropNotifySignup[]
  clickEvents             ClickEvent[]             @relation("UserClicks")
  selfReportedConversions SelfReportedConversion[] @relation("UserConversions")
  wardrobeItems           WardrobeItem[]           @relation("UserWardrobe")
  wishlistItems           WishlistItem[]           @relation("UserWishlist")

  @@index([email])
  @@map("users")
}

model MemberProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  phone     String?
  dob       DateTime?
  avatarUrl String?
  tier      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("member_profiles")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ──────────────────────────── PHASE 2 — CATALOG ────────────────────────────

enum BrandStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AvailabilityStatus {
  IN_STOCK
  OUT_OF_STOCK_AT_RETAILER
  DELISTED
}

enum FilterType {
  SELECT
  MULTI_SELECT
  RANGE
  TOGGLE
}

model Brand {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  logoUrl     String?
  heroUrl     String?
  country     String?
  foundedYear Int?
  description String?
  isFeatured  Boolean     @default(false)
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products Product[]
  story    BrandStory?

  @@index([status, isFeatured])
  @@map("brands")
}

model Category {
  id           String     @id @default(cuid())
  parentId     String?
  parent       Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("Subcategories")
  slug         String     @unique
  name         String
  /// Denormalized path, e.g. "clothing/shirts" — fast lookup, easy breadcrumbs.
  path         String     @unique
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  productsAsCategory    Product[]                 @relation("ProductCategory")
  productsAsSubcategory Product[]                 @relation("ProductSubcategory")
  attributeSchemas      CategoryAttributeSchema[]

  @@index([parentId])
  @@map("categories")
}

model CategoryAttributeSchema {
  id           String     @id @default(cuid())
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeKey String
  displayName  String
  filterType   FilterType @default(SELECT)
  optionsJson  Json?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([categoryId, attributeKey])
  @@map("category_attribute_schemas")
}

model Product {
  id                 String        @id @default(cuid())
  brandId            String
  brand              Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId         String
  category           Category      @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId      String?
  subcategory        Category?     @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  slug               String        @unique
  title              String
  description        String?
  price              Decimal       @db.Decimal(12, 2)
  mrp                Decimal?      @db.Decimal(12, 2)
  discountPct        Decimal?      @db.Decimal(5, 2)
  currency           String        @default("INR")
  primaryRetailer    String?
  status             ProductStatus @default(DRAFT)
  createdByAdminId   String?
  createdByAdmin     User?         @relation("ProductCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  metaTitle          String?
  metaDescription    String?
  tags               String[]      @default([])
  archivedAt         DateTime?
  /// Click + review count denormalized later in Phase 5/8.
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  variants         ProductVariant[]
  images           ProductImage[]
  retailerListings ProductRetailerListing[]
  clickEvents      ClickEvent[]
  wardrobeItems    WardrobeItem[]
  wishlistItems    WishlistItem[]
  articleEmbeds    ArticleProduct[]
  dropProducts     DropProduct[]
  editProducts     EditProduct[]
  lookbookTags     LookbookTag[]

  @@index([status])
  @@index([brandId])
  @@index([categoryId])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  attributes Json     @default("{}")
  color      String?
  size       String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url           String
  altText       String?
  isPrimary     Boolean  @default(false)
  isAiGenerated Boolean  @default(false)
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductRetailerListing {
  id                 String             @id @default(cuid())
  productId          String
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer           String
  retailerProductUrl String
  retailerImageUrl   String?
  rawPrice           Decimal?           @db.Decimal(12, 2)
  lastSyncedAt       DateTime?
  availabilityStatus AvailabilityStatus @default(IN_STOCK)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  affiliateLinks AffiliateLink[]

  @@unique([productId, retailer])
  @@index([retailer])
  @@map("product_retailer_listings")
}

enum AffiliatePartner {
  CUELINKS
  AMAZON
  EARNKARO
  DIRECT
}

model AffiliateLink {
  id                       String                  @id @default(cuid())
  productRetailerListingId String
  productRetailerListing   ProductRetailerListing  @relation(fields: [productRetailerListingId], references: [id], onDelete: Cascade)
  partner                  AffiliatePartner
  rawUrl                   String
  convertedUrl             String
  partnerLinkId            String?
  pendingConversion        Boolean                 @default(false)
  lastValidatedAt          DateTime?
  lastError                String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([productRetailerListingId])
  @@index([pendingConversion])
  @@map("affiliate_links")
}

// ──────────────────────── PHASE 5 — CLICK-OUT FLOW ────────────────────────

enum ClickReportOutcome {
  PURCHASED
  BROWSING
  NEEDS_HELP
}

model ClickEvent {
  id            String            @id @default(cuid())
  trackingId    String            @unique
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer      String
  partner       AffiliatePartner?
  partnerUrl    String
  sourcePageUrl String?
  userId        String?
  user          User?             @relation("UserClicks", fields: [userId], references: [id], onDelete: SetNull)
  sessionId     String?
  userAgent     String?
  ipCountry     String?
  utm           Json?
  redirectedAt  DateTime          @default(now())

  reports        SelfReportedConversion[]
  wardrobeItems  WardrobeItem[]

  @@index([productId])
  @@index([userId])
  @@index([redirectedAt])
  @@map("click_events")
}

model SelfReportedConversion {
  id           String             @id @default(cuid())
  clickEventId String
  clickEvent   ClickEvent         @relation(fields: [clickEventId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?              @relation("UserConversions", fields: [userId], references: [id], onDelete: SetNull)
  outcome      ClickReportOutcome
  reportedAt   DateTime           @default(now())

  @@index([clickEventId])
  @@index([userId])
  @@index([outcome])
  @@map("self_reported_conversions")
}

model WardrobeItem {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation("UserWardrobe", fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  retailer           String
  clickEventId       String?
  clickEvent         ClickEvent? @relation(fields: [clickEventId], references: [id], onDelete: SetNull)
  selfReportedPrice  Decimal?    @db.Decimal(12, 2)
  selfReportedDate   DateTime?
  notes              String?
  tags               String[]    @default([])
  removedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wardrobe_items")
}

model WishlistItem {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("UserWishlist", fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifyOnPriceDrop Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

model Avatar {
  id                String   @id @default(cuid())
  name              String
  referenceImageUrl String
  promptTemplate    String
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("avatars")
}

// ──────────────────────── PHASE 6 — ARTICLES ────────────────────────

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Article {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  heroUrl         String?
  excerpt         String?
  /// Markdown body. Product embeds use `<div data-product="slug"></div>`
  /// markers that the renderer replaces with shoppable product cards.
  bodyMd          String        @default("")
  status          ArticleStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  authorId        String?
  author          User?         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tags            String[]      @default([])
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  /// Estimated reading time in minutes (auto-calculated on save at ~225 wpm).
  readingMinutes  Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  articleProducts ArticleProduct[]

  @@index([status, publishedAt])
  @@index([scheduledAt])
  @@map("articles")
}

model ArticleProduct {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([articleId, productId])
  @@index([articleId])
  @@map("article_products")
}

// ───────── PHASE 7 — DROPS / LOOKBOOKS / EDITS / BANNERS / BRAND STORIES ─────────

enum DropStatus {
  SCHEDULED
  LIVE
  ENDED
  ARCHIVED
}

model Drop {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  heroUrl     String?
  description String?
  launchAt    DateTime
  endsAt      DateTime?
  status      DropStatus @default(SCHEDULED)
  /// Stamped when the scheduler flips status → LIVE.
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  dropProducts  DropProduct[]
  notifySignups DropNotifySignup[]

  @@index([status, launchAt])
  @@index([launchAt])
  @@map("drops")
}

model DropProduct {
  id        String  @id @default(cuid())
  dropId    String
  drop      Drop    @relation(fields: [dropId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([dropId, productId])
  @@index([dropId])
  @@map("drop_products")
}

model DropNotifySignup {
  id         String    @id @default(cuid())
  dropId     String
  drop       Drop      @relation(fields: [dropId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([dropId, email])
  @@index([dropId, notifiedAt])
  @@map("drop_notify_signups")
}

enum LookbookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Lookbook {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  heroUrl     String?
  description String?
  status      LookbookStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  images LookbookImage[]

  @@index([status])
  @@map("lookbooks")
}

model LookbookImage {
  id         String   @id @default(cuid())
  lookbookId String
  lookbook   Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)
  imageUrl   String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  tags LookbookTag[]

  @@index([lookbookId])
  @@map("lookbook_images")
}

model LookbookTag {
  id              String        @id @default(cuid())
  lookbookImageId String
  lookbookImage   LookbookImage @relation(fields: [lookbookImageId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Hotspot position relative to the image, both 0–100.
  xPercent        Decimal       @db.Decimal(5, 2)
  yPercent        Decimal       @db.Decimal(5, 2)
  createdAt       DateTime      @default(now())

  @@index([lookbookImageId])
  @@map("lookbook_tags")
}

enum EditStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Edit {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  heroUrl          String?
  description      String?
  status           EditStatus @default(DRAFT)
  /// At most one edit at a time should be the home feature; admin-enforced.
  isFeaturedOnHome Boolean    @default(false)
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  editProducts EditProduct[]

  @@index([status])
  @@index([isFeaturedOnHome])
  @@map("edits")
}

model EditProduct {
  id        String  @id @default(cuid())
  editId    String
  edit      Edit    @relation(fields: [editId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([editId, productId])
  @@index([editId])
  @@map("edit_products")
}

enum HomeBannerStatus {
  ACTIVE
  HIDDEN
}

model HomeBanner {
  id           String           @id @default(cuid())
  imageUrl     String
  headline     String?
  ctaLabel     String?
  ctaLink      String?
  displayOrder Int              @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  status       HomeBannerStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, displayOrder])
  @@map("home_banners")
}

enum BrandStoryStatus {
  DRAFT
  PUBLISHED
}

model BrandStory {
  id        String           @id @default(cuid())
  brandId   String           @unique
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  heroUrl   String?
  /// Markdown body. Rendered with rehype-sanitize on the storefront so raw
  /// HTML is stripped — XSS-safe even when admin pastes untrusted content.
  bodyMd    String           @default("")
  status    BrandStoryStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("brand_stories")
}
