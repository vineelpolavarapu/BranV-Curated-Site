# branv.in Agent — environment variables
# These are READ FROM THE REPO-ROOT .env (c:\vineel\BranV\.env), shared with apps/api + apps/web.
# This file documents the agent's vars only — do NOT put real secrets here.

# ── Database (reuse the existing BranV Postgres; asyncpg driver) ─────────────
# DATABASE_URL=postgresql+asyncpg://branv:branv@localhost:5432/branv_dev

# ── OpenAI (single LLM provider — supply later) ──────────────────────────────
# OPENAI_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Retrieval (embedding recall; no reranker) ────────────────────────────────
RECALL_SIZE=50
RESULT_TOPK=8

# ── Observability (optional) ─────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=branv-agent
# LANGSMITH_API_KEY=
