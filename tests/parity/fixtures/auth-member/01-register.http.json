{
  "description": "POST /api/auth/register creates a fresh member",
  "request": {
    "method": "POST",
    "path": "/api/auth/register",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "email": "parity-member-fixture@branv.local",
      "password": "parity-test-pw-1234",
      "firstName": "Parity",
      "lastName": "Member"
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "access-control-allow-credentials": "true",
      "access-control-allow-origin": "http://localhost:3000",
      "content-type": "application/json; charset=utf-8",
      "vary": "Origin",
      "x-request-id": "<uuid>"
    },
    "body": {
      "status": "ok",
      "message": "Account created. Check your email to verify."
    },
    "setCookies": []
  }
}
