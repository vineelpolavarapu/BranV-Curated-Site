{
  "description": "GET /api/ready returns 200 when DB is up",
  "request": {
    "method": "GET",
    "path": "/api/ready",
    "headers": {},
    "body": null
  },
  "response": {
    "status": 503,
    "headers": {
      "access-control-allow-credentials": "true",
      "access-control-allow-origin": "http://localhost:3000",
      "content-type": "application/json; charset=utf-8",
      "vary": "Origin",
      "x-request-id": "<uuid>"
    },
    "body": {
      "status": "not_ready",
      "checks": {
        "db": {
          "ok": true,
          "latencyMs": "<volatile>"
        },
        "storage": {
          "ok": false,
          "error": "socket hang up"
        }
      },
      "timestamp": "<iso-datetime>"
    },
    "setCookies": []
  }
}
